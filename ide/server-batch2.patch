+mod cache_key_tests {
+    use super::gw_cache_key;
+    use serde_json::json;
+
+    fn body() -> serde_json::Value {
+        json!({ "model": "gpt-5.5", "messages": [{ "role": "user", "content": "hi" }] })
+    }
+
+    #[test]
