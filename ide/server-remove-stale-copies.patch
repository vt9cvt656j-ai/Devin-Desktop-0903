-    .await?;
-
-    let (plan, plan_exp, q_total, q_window, q_weekly_cap, q_week_used, credits): (
-        String, Option<chrono::DateTime<chrono::Utc>>, i64, i64, i64, i64, i64,
-    ) = sqlx::query_as(
-        "SELECT plan, plan_expires_at, quota_total_cents, quota_window_cents, \
