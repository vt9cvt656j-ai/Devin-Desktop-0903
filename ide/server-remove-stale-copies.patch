-fn needs_vision_help(model_id: &str) -> bool {
-    let m = model_id.to_lowercase();
-    let native = m.contains("gpt")
-        || m.contains("gemini")
-        || m.contains("claude")
-        || m.contains("vision")
-        || m.contains("-vl")
-        || m.contains("image")
-        || m.contains("o3")
-        || m.contains("o4");
-    !native
