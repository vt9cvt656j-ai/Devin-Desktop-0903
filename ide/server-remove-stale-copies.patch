-        return 0;
-    }
-    // Official per-model price; fall back to the admin's per-connection override.
-    let (off_in, off_out) = official_price(model_id).unwrap_or((admin_in, admin_out));
-    if off_in <= 0.0 && off_out <= 0.0 {
