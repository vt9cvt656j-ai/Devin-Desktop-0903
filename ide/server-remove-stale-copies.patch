-    let cache_creation = u
-        .get("cache_creation_input_tokens")
-        .and_then(|v| v.as_f64())
-        .unwrap_or(0.0);
-    let cached = u
-        .get("prompt_tokens_details")
-        .and_then(|d| d.get("cached_tokens"))
