-    let gi = |keys: &[&str]| -> i64 {
-        for k in keys {
-            if let Some(n) = u.get(*k).and_then(|x| x.as_i64()) { return n; }
-        }
-        0
-    };
-    let cached = gi(&["cache_read_input_tokens"])
-        .max(u.pointer("/prompt_tokens_details/cached_tokens").and_then(|x| x.as_i64()).unwrap_or(0))
-        .max(gi(&["prompt_cache_hit_tokens"]));
-    BillTokens {
-        prompt: gi(&["prompt_tokens", "input_tokens"]),
-        completion: gi(&["completion_tokens", "output_tokens"]),
-        cached,
-        model_name: model_name.to_string(),
-        estimated,
-    }
-}
