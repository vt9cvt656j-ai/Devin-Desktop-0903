-        || m.contains("flash")
-        || m.contains("haiku")
-        || m.contains("-mini")
-        || m.contains("-lite")
-        || m.contains("-small")
-        || m.contains("-air")
-        || m.contains("glm-4-flash")
-        || m.contains("qwen-turbo")
-        || m.contains("qwen-plus")
-        || m.contains("ernie")
-        || m.contains("hunyuan-lite")
-        || m.contains("doubao-lite")
-        || m.contains("gpt-4o-mini")
-        || m.contains("gpt-5-mini")
-        || m.contains("o1-mini")
-        || m.contains("o3-mini")
