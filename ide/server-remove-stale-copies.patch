-        let tcs = match ch.pointer_mut("/message/tool_calls").and_then(|t| t.as_array_mut()) {
-            Some(t) => t,
-            None => continue,
-        };
-        for tc in tcs {
-            let args_val = match tc.pointer_mut("/function/arguments") {
-                Some(v) => v,
-                None => continue,
