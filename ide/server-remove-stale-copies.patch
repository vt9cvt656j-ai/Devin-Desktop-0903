-const MAX_STATIC_TOOLS_PER_REQUEST: usize = 32;
-
-fn prompt_path(name: &str) -> PathBuf {
-    PathBuf::from(env!("CARGO_MANIFEST_DIR"))
-        .join("prompts")
-        .join(format!("{name}.txt"))
-}
-
-fn tools_path() -> PathBuf {
-    PathBuf::from(env!("CARGO_MANIFEST_DIR"))
-        .join("prompts")
-        .join("tools.json")
-}
