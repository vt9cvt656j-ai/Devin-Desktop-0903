-/// BM25 search over the corpus. `domain` optionally restricts to one domain.
-pub fn search(query: &str, domain: Option<&str>, top_k: usize) -> Vec<SearchHit> {
-    const K1: f64 = 1.5;
-    const B: f64 = 0.75;
-    let idx = get();
-    if idx.chunks.is_empty() {
-        return Vec::new();
-    }
-    let q_toks = tokenize(&expand_query(query));
-    if q_toks.is_empty() {
-        return Vec::new();
-    }
