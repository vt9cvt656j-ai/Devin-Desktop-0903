-/// REAL per-token billing with SEPARATE input / output unit prices, in USD per 1,000,000
-/// tokens — the exact unit real model APIs publish ($/1M). This is the "真正的计费":
-///   cost = input_tokens × input_price/1e6  +  output_tokens × output_price/1e6   (→ cents)
-///
-/// SAFETY (a past flat-rate-misused-as-per-1K attempt over-charged 10–30×):
-///  • If NEITHER price is set (both 0) → returns the flat per-call fee UNCHANGED, so a
-///    model bills exactly as before until you set its real prices in the admin.
-///  • Uses only the upstream's AUTHORITATIVE `usage` counts — never guesses token counts.
-///    No usage reported → falls back to the flat fee instead of estimating.
-///  • Hard $50/call ceiling so a malformed/huge upstream usage can never drain a balance.
-/// Cache-aware (cached input at 0.1×); on this relay cache_control is stripped so `cached`
-/// is normally 0, but the math stays correct for a caching upstream.
-fn compute_io_cost(usage: Option<&serde_json::Value>, input_price: f64, output_price: f64, flat_cents: i64) -> i64 {
-    const CACHE_READ_FACTOR: f64 = 0.1;
-    const CACHE_WRITE_FACTOR: f64 = 1.25;
-    const COST_CEILING_CENTS: f64 = 5000.0; // $50/call backstop — no legit single call hits this
-    // No real prices configured → keep the existing flat per-call fee (safe default).
-    if input_price <= 0.0 && output_price <= 0.0 {
-        return flat_cents.max(0);
-    }
-    // Real prices set but the upstream reported no usable usage → fall back to flat rather
-    // than GUESS token counts. Authoritative counts only.
-    let u = match usage {
-        Some(u) if u.is_object() => u,
-        _ => return flat_cents.max(0),
-    };
-    let completion = u
-        .get("completion_tokens")
-        .and_then(|v| v.as_f64())
-        .or_else(|| u.get("output_tokens").and_then(|v| v.as_f64()))
-        .unwrap_or(0.0);
-    let prompt = u
-        .get("prompt_tokens")
-        .and_then(|v| v.as_f64())
-        .or_else(|| u.get("input_tokens").and_then(|v| v.as_f64()))
-        // Only total_tokens reported → the non-output remainder is input.
-        .or_else(|| u.get("total_tokens").and_then(|v| v.as_f64()).map(|t| (t - completion).max(0.0)))
-        .unwrap_or(0.0);
-    if prompt <= 0.0 && completion <= 0.0 {
-        return flat_cents.max(0); // usage object present but empty → flat
-    }
-    let cache_read = u.get("cache_read_input_tokens").and_then(|v| v.as_f64()); // Anthropic
-    let cache_creation = u
-        .get("cache_creation_input_tokens")
-        .and_then(|v| v.as_f64())
-        .unwrap_or(0.0);
-    let cached = u
-        .get("prompt_tokens_details")
-        .and_then(|d| d.get("cached_tokens"))
-        .and_then(|v| v.as_f64())
-        .or_else(|| u.get("prompt_cache_hit_tokens").and_then(|v| v.as_f64())) // DeepSeek
-        .or(cache_read)
-        .unwrap_or(0.0);
-    let billable_input = if cache_read.is_some() {
-        prompt + cached * CACHE_READ_FACTOR + cache_creation * CACHE_WRITE_FACTOR
-    } else {
-        (prompt - cached).max(0.0) + cached * CACHE_READ_FACTOR
-    };
-    // USD = tokens / 1e6 × price_per_1M;  cents = USD × 100.
-    let usd = (billable_input * input_price + completion * output_price) / 1_000_000.0;
-    (usd * 100.0).round().clamp(0.0, COST_CEILING_CENTS) as i64
-}
