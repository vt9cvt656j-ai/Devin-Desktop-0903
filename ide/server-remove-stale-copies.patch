-fn expand_query(q: &str) -> String {
-    let mut extra = String::new();
-    for (cn, en) in CN_EN {
-        if q.contains(cn) {
-            extra.push(' ');
-            extra.push_str(en);
-        }
-    }
-    if extra.is_empty() {
-        q.to_string()
-    } else {
-        format!("{q}{extra}")
-    }
-}
