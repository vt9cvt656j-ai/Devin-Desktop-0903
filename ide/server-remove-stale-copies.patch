-pub fn get() -> &'static KnowledgeIndex {
-    INDEX.get_or_init(|| {
-        let dir = std::env::var("KNOWLEDGE_DIR").unwrap_or_else(|_| "./knowledge".to_string());
-        load(&dir)
-    })
-}
