-                | "ask_user"
-                | "list_dir"
-                | "read_file"
-                | "find_files"
-                | "search"
-                | "semantic_search"
-                | "lsp_symbols"
-                | "lsp_definition"
-                | "lsp_references"
-                | "knowledge_search"
-                | "web_search"
-                | "web_fetch"
-                | "research_project"
-                | "run_subagent"
-        ),
-        "explorer" | "reviewer" => matches!(
-            name,
-            "think"
-                | "ask_user"
-                | "list_dir"
-                | "read_file"
-                | "find_files"
-                | "search"
-                | "semantic_search"
-                | "lsp_symbols"
-                | "find_symbol"
