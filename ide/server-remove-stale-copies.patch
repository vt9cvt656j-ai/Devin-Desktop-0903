-                .bind(uid)
-                .execute(&state.db)
-                .await;
-            }
-            let _ = sqlx::query(
-                "INSERT INTO model_usage (user_id, model_id, cost_cents) VALUES ($1,$2,$3)",
-            )
-            .bind(uid)
-            .bind(conn.id)
-            .bind(cost)
-            .execute(&state.db)
-            .await;
-        }
-    }
-
-    Ok(Json(data).into_response())
-}
