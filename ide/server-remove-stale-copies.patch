-/// upsert 一条临时授权（续期到 now + days），清掉过期项，返回到期时间戳。
-fn grant_temp(account: &str, days: i64) -> i64 {
-    let _lk = GRANTS_LOCK.lock().unwrap_or_else(|e| e.into_inner());
