-        Some(u) if u.is_object() => u,
-        _ => return 0,
-    };
-    let completion = u
-        .get("completion_tokens")
-        .and_then(|v| v.as_f64())
-        .or_else(|| u.get("output_tokens").and_then(|v| v.as_f64()))
-        .unwrap_or(0.0);
-    let prompt = u
-        .get("prompt_tokens")
-        .and_then(|v| v.as_f64())
-        .or_else(|| u.get("input_tokens").and_then(|v| v.as_f64()))
