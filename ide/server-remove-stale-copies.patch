-        .unwrap_or(8192);
-    // For adaptive thinking: no budget_tokens, just ensure a generous max_tokens.
-    // For budget-based (3.7): ensure max_tokens > budget_tokens.
-    if thinking_on {
-        let budget = thinking.as_ref()
-            .and_then(|t| t.get("budget_tokens"))
-            .and_then(|v| v.as_i64())
