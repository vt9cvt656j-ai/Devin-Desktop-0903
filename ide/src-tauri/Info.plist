<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Production traffic uses HTTPS. Local networking remains enabled for the
	     Vite development server without allowing arbitrary cleartext internet traffic. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Voice input: the composer's mic button records audio and transcribes it. macOS CRASHES the
	     app if it accesses the mic / speech recognition without these usage strings present. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Michael IDE 用麦克风做语音输入——把你说的话转成文字填进 AI 对话框。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Michael IDE 用语音识别把你的语音转写成文字。</string>
</dict>
</plist>
