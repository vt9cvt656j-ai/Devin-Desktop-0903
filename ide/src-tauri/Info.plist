<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The backend gateway (default http://209.97.172.123) is plain HTTP. macOS
	     App Transport Security blocks cleartext HTTP from WKWebView by default,
	     which breaks the JS-side auth/login fetches in the packaged app (they
	     work in `tauri dev` only because the page is served from http://localhost).
	     Allow cleartext loads so the webview can reach the HTTP backend. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Voice input: the composer's mic button records audio and transcribes it. macOS CRASHES the
	     app if it accesses the mic / speech recognition without these usage strings present. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Michael IDE 用麦克风做语音输入——把你说的话转成文字填进 AI 对话框。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Michael IDE 用语音识别把你的语音转写成文字。</string>
</dict>
</plist>
