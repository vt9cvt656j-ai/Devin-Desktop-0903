{
  "id": "michael.chinese-language-pack",
  "name": "简体中文语言包",
  "version": "1.0.0",
  "description": "Michael IDE 简体中文界面语言包，安装后 IDE 全部界面切换为中文。",
  "author": "Michael IDE",
  "main": "index.js",
  "permissions": ["locale"],
  "contributes": {
    "commands": [
      { "id": "locale.switchToChinese", "title": "切换到简体中文" },
      { "id": "locale.switchToEnglish", "title": "Switch to English" }
    ]
  }
}
