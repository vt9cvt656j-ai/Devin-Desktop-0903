{
  "id": "michael.code-formatter",
  "name": "Code Formatter",
  "version": "1.0.0",
  "description": "Auto-format code with consistent indentation, trailing whitespace cleanup, and line ending normalization.",
  "author": "Michael IDE",
  "main": "index.js",
  "permissions": ["editor"],
  "contributes": {
    "commands": [
      { "id": "formatter.format", "title": "Format: Format Document" },
      { "id": "formatter.trimWhitespace", "title": "Format: Trim Trailing Whitespace" },
      { "id": "formatter.sortLines", "title": "Format: Sort Selected Lines" },
      { "id": "formatter.removeDuplicateLines", "title": "Format: Remove Duplicate Lines" },
      { "id": "formatter.jsonPrettify", "title": "Format: Prettify JSON" }
    ]
  }
}
