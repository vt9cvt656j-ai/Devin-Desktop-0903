{
  "id": "michael.spell-checker",
  "name": "Spell Checker",
  "version": "1.0.0",
  "description": "Flags common misspellings in the active file via editor diagnostics.",
  "author": "Michael IDE",
  "main": "index.js",
  "permissions": ["editor", "diagnostics"],
