{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Michael IDE",
  "version": "0.1.0",
  "identifier": "ai.devin.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5174 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Michael IDE",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https: http://209.97.172.123; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 weiligon",
    "shortDescription": "A macOS-style code editor with an AI assistant sidebar.",
    "longDescription": "Michael IDE is a native-feeling macOS code editor built on Tauri and Monaco, with a built-in AI assistant sidebar that connects to any OpenAI-compatible model."
  },
  "plugins": {
    "macos-fps": {},
    "updater": {
      "endpoints": [
        "https://github.com/fendoushaonian/Devin-Desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5QjAyOUI0QUYxRTA1RjkKUldUNUJSNnZ0Q213bWNhMkRoYVdWaTZRMVFub2YweFcvNHNmQzhTUVhrZVJUWVNHWkxPMlB1eUQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
