+/// Deterministic cache key for a chat request. serde_json serializes Map keys sorted, so
+/// the same request always produces the same key.
+///
+/// Scoped PER USER, and hashed with SHA-256. Both matter:
+///
+/// * The key used to be global, so an entry stored by one account could be served to
+///   another. Scoping to the caller means a collision can only ever hit your own history.
+/// * It used to use `DefaultHasher`, which is a hash-table primitive: not collision
+///   resistant, and `DefaultHasher::new()` is specified to use fixed zero keys, so anyone
+///   could reproduce it offline and grind for a body colliding with a known request. (The
+///   old comment claimed 128 bits, but the second hash fed a constant plus the *same*
+///   bytes to the *same* keyed function, which is correlated with the first, not
+///   independent.) Rust also reserves the right to change that algorithm between releases.
+fn gw_cache_key(uid: uuid::Uuid, body: &serde_json::Value) -> String {
+    use sha2::{Digest, Sha256};
+    let mut h = Sha256::new();
+    h.update(uid.as_bytes());
+    h.update(b"\x00"); // domain separator: uid can't run into the body
+    h.update(serde_json::to_vec(body).unwrap_or_default());
+    format!("gwc:{:x}", h.finalize())
 }
 
