+// ---- live account/role checks ----------------------------------------------
+// A JWT here lives for 30 days and there is no revocation list, so the token proves
+// only what was true at login. Every authorization decision therefore re-reads the
+// user row: otherwise a demoted admin keeps admin power, and a deleted account keeps
+// working, until the token happens to expire.
+
+/// Resolve the caller's user id and assert the account still exists.
+pub async fn require_user(state: &AppState, claims: &Claims) -> ApiResult<uuid::Uuid> {
+    let uid = uuid::Uuid::parse_str(&claims.sub).map_err(|_| AppError::unauthorized("令牌损坏"))?;
+    sqlx::query_scalar::<_, uuid::Uuid>("SELECT id FROM users WHERE id = $1")
+        .bind(uid)
+        .fetch_optional(&state.db)
+        .await?
+        .ok_or_else(|| AppError::unauthorized("账号已注销，请重新登录"))
+}
+
+/// Assert the caller is CURRENTLY an admin, from `users.role` rather than `claims.role`.
+pub async fn require_admin(state: &AppState, claims: &Claims) -> ApiResult<uuid::Uuid> {
+    let uid = uuid::Uuid::parse_str(&claims.sub).map_err(|_| AppError::unauthorized("令牌损坏"))?;
+    let role: Option<String> = sqlx::query_scalar("SELECT role FROM users WHERE id = $1")
+        .bind(uid)
+        .fetch_optional(&state.db)
+        .await?;
+    match role.as_deref() {
+        Some("admin") => Ok(uid),
+        Some(_) => Err(AppError::forbidden("需要管理员权限")),
+        None => Err(AppError::unauthorized("账号已注销，请重新登录")),
+    }
+}
+
+// ---- password-login brute-force guard --------------------------------------
+// The emailed-code path is already budgeted (per-code + hourly). Password login had no
+// budget at all — only bcrypt's cost factor, which slows an attacker but never stops one.
+
+/// Failed passwords tolerated per account per hour before the account is paused.
+const LOGIN_FAIL_PER_EMAIL: i64 = 10;
+/// Failed passwords tolerated per source IP per hour — stops one host spraying many accounts.
+const LOGIN_FAIL_PER_IP: i64 = 50;
+const LOGIN_FAIL_WINDOW_SECS: i64 = 3600;
+
+/// A throwaway hash used to spend the same CPU on "no such account" as on a wrong
+/// password, so response latency doesn't reveal which accounts exist.
+static DUMMY_HASH: std::sync::LazyLock<String> = std::sync::LazyLock::new(|| {
+    bcrypt::hash("michael-timing-equalizer", bcrypt::DEFAULT_COST).unwrap_or_default()
+});
+
+/// Client IP as nginx sees it (`X-Real-IP`, else the first `X-Forwarded-For` hop).
+fn client_ip(headers: &axum::http::HeaderMap) -> String {
+    headers
+        .get("x-real-ip")
+        .and_then(|v| v.to_str().ok())
+        .or_else(|| {
+            headers
+                .get("x-forwarded-for")
+                .and_then(|v| v.to_str().ok())
+                .and_then(|s| s.split(',').next())
+        })
+        .map(|s| s.trim().to_string())
+        .filter(|s| !s.is_empty())
+        .unwrap_or_else(|| "unknown".to_string())
+}
+
+/// Reject the attempt outright when either budget is spent; otherwise hand back the two
+/// counter keys so the caller can record the outcome.
+async fn login_guard(state: &AppState, email: &str, ip: &str) -> ApiResult<(String, String)> {
+    let mut conn = state.redis.clone();
+    let ekey = format!("login_fail:{}", email.trim().to_lowercase());
+    let ikey = format!("login_fail_ip:{ip}");
+    let e_fails: Option<i64> = redis::cmd("GET").arg(&ekey).query_async(&mut conn).await?;
+    let i_fails: Option<i64> = redis::cmd("GET").arg(&ikey).query_async(&mut conn).await?;
+    if e_fails.unwrap_or(0) >= LOGIN_FAIL_PER_EMAIL || i_fails.unwrap_or(0) >= LOGIN_FAIL_PER_IP {
+        return Err(AppError::bad(
+            "登录失败次数过多，请稍后再试，或改用邮箱验证码登录",
+        ));
+    }
+    Ok((ekey, ikey))
+}
+
+async fn login_fail(state: &AppState, ekey: &str, ikey: &str) {
+    let mut conn = state.redis.clone();
+    for k in [ekey, ikey] {
+        let _: Result<i64, _> = redis::cmd("INCR").arg(k).query_async(&mut conn).await;
+        // EXPIRE on every increment (idempotent): setting it only on the first failure
+        // risks a crash in between leaving a TTL-less key that locks the account out forever.
+        let _: Result<(), _> = redis::cmd("EXPIRE")
+            .arg(k)
+            .arg(LOGIN_FAIL_WINDOW_SECS)
+            .query_async(&mut conn)
+            .await;
+    }
+}
+
+async fn login_ok(state: &AppState, ekey: &str, ikey: &str) {
+    let mut conn = state.redis.clone();
+    let _: Result<(), _> = redis::cmd("DEL").arg(ekey).arg(ikey).query_async(&mut conn).await;
+}
