+/// RAII reservation. Released in `Drop`, so every early return, `?` and panic path gives
+/// it back; `Drop` cannot be async, hence the spawn.
+pub(crate) struct InflightHold {
+    state: AppState,
+    uid: uuid::Uuid,
+    cents: i64,
+}
+
+impl InflightHold {
+    async fn acquire(state: &AppState, uid: uuid::Uuid, cents: i64) -> Self {
+        let mut conn = state.redis.clone();
+        let key = inflight_key(uid);
+        let _: Result<i64, _> = redis::cmd("INCRBY")
+            .arg(&key)
+            .arg(cents)
+            .query_async(&mut conn)
+            .await;
+        // EXPIRE on every acquire (idempotent) so the key always carries a TTL.
+        let _: Result<(), _> = redis::cmd("EXPIRE")
+            .arg(&key)
+            .arg(INFLIGHT_TTL_SECS)
+            .query_async(&mut conn)
+            .await;
+        Self { state: state.clone(), uid, cents }
+    }
+}
+
+impl Drop for InflightHold {
+    fn drop(&mut self) {
+        let (st, uid, cents) = (self.state.clone(), self.uid, self.cents);
+        // try_current() rather than tokio::spawn: Drop can run while the runtime is
+        // shutting down, where spawn panics. Failing to release is harmless there — the
+        // key carries INFLIGHT_TTL_SECS and expires on its own.
+        let Ok(handle) = tokio::runtime::Handle::try_current() else {
+            return;
+        };
+        handle.spawn(async move {
+            let mut conn = st.redis.clone();
+            let key = inflight_key(uid);
+            let left: Result<i64, _> = redis::cmd("DECRBY")
+                .arg(&key)
+                .arg(cents)
+                .query_async(&mut conn)
+                .await;
+            if matches!(left, Ok(n) if n <= 0) {
+                let _: Result<(), _> = redis::cmd("DEL").arg(&key).query_async(&mut conn).await;
+            }
+        });
+    }
