+// ---- access gate + concurrency reservation ---------------------------------
+
+/// Cents held while a call is in flight.
+///
+/// The balance in Postgres only moves when a call FINISHES, so a burst of concurrent
+/// requests all read the same balance and all pass the gate: a user with 10¢ could run
+/// 50 parallel calls and still pay 10¢. The IDE's own multi-agent fan-out makes that a
+/// routine pattern, not a contrived one. So calls that are still running are counted, in
+/// Redis (shared across workers), against the balance.
+///
+/// A flat hold is deliberate — it bounds concurrency in proportion to the balance without
+/// having to predict a call's cost, and it is released in full when the call settles, so
+/// the user is only ever charged the real `compute_cost` amount.
+const INFLIGHT_HOLD_CENTS: i64 = 25;
+/// A hold cannot outlive this, so a killed process can never strand one.
+const INFLIGHT_TTL_SECS: i64 = 900;
+
+fn inflight_key(uid: uuid::Uuid) -> String {
+    format!("inflight:{uid}")
+}
+
+async fn inflight_now(state: &AppState, uid: uuid::Uuid) -> i64 {
+    let mut conn = state.redis.clone();
+    let v: Result<Option<i64>, _> = redis::cmd("GET")
+        .arg(inflight_key(uid))
+        .query_async(&mut conn)
+        .await;
+    v.ok().flatten().unwrap_or(0).max(0)
+}
