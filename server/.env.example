# Michael 总后台 — copy to `.env` and fill in. NEVER commit the real .env.

# --- required ---
DATABASE_URL=postgres://michael:CHANGE_ME@localhost:5432/michael
JWT_SECRET=CHANGE_ME_to_a_long_random_string

# --- optional (sane defaults shown) ---
REDIS_URL=redis://127.0.0.1:6379
BIND_ADDR=0.0.0.0:8080
DB_MAX_CONNECTIONS=20
CODE_TTL_SECS=600
JWT_TTL_SECS=2592000
RUST_LOG=info,sqlx=warn
IDE_UPDATE_MANIFEST_URL=https://github.com/fendoushaonian/Devin-Desktop/releases/latest/download/latest.json

# --- IDE signed release control (admin -> GitHub Actions) ---
# Fine-grained PAT: Metadata read, Actions read/write, Contents read/write.
# Keep the real token only in the server environment; the admin API never returns it.
IDE_RELEASE_GITHUB_TOKEN=
IDE_RELEASE_GITHUB_REPO=fendoushaonian/Devin-Desktop
IDE_RELEASE_GITHUB_WORKFLOW=ide-package.yml

# --- email (QQ SMTP). Leave empty for dev mode (codes go to the server log). ---
QQ_SMTP_USER=
QQ_SMTP_PASS=
SMTP_HOST=smtp.qq.com

# --- used by docker-compose / deploy.sh (not by the app itself) ---
POSTGRES_USER=michael
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=michael

# michael-compression（1M/2M/5M 上下文压缩缓存）总开关。默认关闭。
#
# 开之前必须先修完发布前审查列出的阻断项，最关键的一条：compression_write_back
# 会把每条消息重写成 {role, content}，丢掉 tool_calls / tool_call_id —— agent
# 模式发的正是这些，上游会直接拒收。
#
# 注意这个开关同时控制 /api/me 是否对外报告档位。只报档位却不真压，会让客户端
# 关掉自己的本地压缩，结果两边都不压。
MICHAEL_COMPRESSION_ENABLED=0

# ── 代码托管连接（GitHub / Gitee）────────────────────────────────────────────────
#
# 账号页的「代码托管」模块用这两组凭据发起 OAuth；留空 = 该平台不显示为可连接，
# 按钮是灰的，而不是点下去跳到平台的报错页。
#
# OAuth App 必须由运营方在自己的 GitHub / Gitee 账号下注册 —— 应用属于那个身份，
# secret 也是他们的。回调地址必须与这里的 IDE_UPDATE_PUBLIC_BASE 完全一致：
#   GitHub  https://code.mrday.one/api/integrations/github/callback
#   Gitee   https://code.mrday.one/api/integrations/gitee/callback
#
# 申请的权限保持最小：GitHub 只要 repo + read:user，Gitee 只要 projects + user_info。
# 拿到的 access token 只存在 connected_accounts 表里，任何接口都不会把它发给前端 ——
# 一个带 repo 权限的 GitHub token 等于该用户全部私有仓库的读写权。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
