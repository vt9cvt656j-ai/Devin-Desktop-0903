# 测试环境的配置模板。复制成 .env.test 再填。
#
#   cp .env.test.example .env.test
#
# 它和生产的 .env 是**两份独立的文件**，服务器上也在两个不同的目录里
# （/opt/michael-ide-deploy/server-test vs .../server）。
#
# ⚠️ 下面前两项是隔离的关键。填错的后果不是"测试环境起不来"，而是
#    **测试环境去抢生产的端口、往生产的静态站目录里写文件**。

# 宿主端口。生产是 8080，测试必须是别的。
# Compose 用它决定服务读哪个 env 文件（docker-compose.yml 里的 ${ENV_FILE_NAME}）。
# 测试环境必须是 .env.test —— 不设的话会去读不存在的 .env，容器起不来。
ENV_FILE_NAME=.env.test
BACKEND_PORT=8081
# 静态站目录。生产是 /var/www/michael-sites，测试必须是别的。
SITES_DIR=/var/www/michael-sites-test

# 数据库。卷已经由 compose 项目名（server-test）自动隔离成 server-test_pgdata，
# 但用户名/库名也建议区分开，出问题时一眼看得出连的是哪套。
POSTGRES_USER=michael_test
POSTGRES_PASSWORD=换成一个只用于测试的强口令
POSTGRES_DB=michael_test

# 和生产**不要**共用。测试环境签发的登录令牌不该能用在生产上。
JWT_SECRET=换成一个只用于测试的随机串

# 字段加密密钥。
#
# 不配的话 field_crypto 会 passthrough（原样存明文），于是 api_key_enc 里存的其实是明文。
# 想在测试环境验证 API key 加密这条链路，这里就必须配一个；而且**不要**和生产同一个。
# 生成：openssl rand -base64 32
FIELD_ENC_KEY=

# 邮件：测试环境一般不真发信，留空即可。
QQ_SMTP_USER=
QQ_SMTP_PASS=

# 上游模型。测试环境建议只配一条便宜线路，或者干脆留空只测不花钱的路径。
# 真要连上游的话，用一把**额度很小**的 key——测试环境跑飞了不该烧掉生产的余额。
