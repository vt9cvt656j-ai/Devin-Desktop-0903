# MSE-1 build-time settings for the user console. Copy to `.env` (or `.env.production`)
# and fill in. Protocol: ../docs/MSE.md §10.
#
# Vite inlines these at build time — changing them means rebuilding and republishing the
# bundle, not restarting anything.

# Gateway origin. Leave empty: nginx serves this console under /account/ on the same host
# as the API, so relative paths already reach the right gateway. Setting it would make
# every call cross-origin, which then depends on Access-Control-Expose-Headers listing
# every X-Mse-* header — a way to break decryption for no gain.
VITE_MSE_BASE=

# Accepted server key ids, comma-separated. Empty = accept whatever key the gateway
# advertises, which only defeats a passive eavesdropper. Pinning is what also stops an
# active man-in-the-middle holding a CA the browser trusts — a pinned build refuses an
# unrecognised gateway and has no plaintext fallback.
#
# The kid is printed by the gateway at boot and served by GET /api/crypto/pubkey. During
# a key rotation list both the new and the old one, or this build locks itself out.
VITE_MSE_PIN=

# auto | require
#   auto    — falls back to plaintext when the gateway has MSE off or the key cannot be
#             fetched. Correct while MSE_MODE=optional is still rolling out.
#   require — no plaintext code path at all; a downgrade raises instead of quietly
#             sending in the clear. Switch to this once the gateway is on MSE_MODE=required.
VITE_MSE_MODE=auto
